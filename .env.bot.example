# Telegram bot -> /etc/hyvpn/.env.bot

# Token from @BotFather
BOT_TOKEN=123456:replace_me

# Comma-separated Telegram user IDs allowed to use the bot.
# An empty list denies everyone. Send /start to the bot to learn your ID.
ALLOWED_TG_IDS=123456789

# Interface language until the operator picks one with the 🌐 button: ru or en
DEFAULT_LANG=ru

# Must match .env.core
DATABASE_PATH=/var/lib/hyvpn/hyvpn.sqlite3
SERVER_DOMAIN=vpn.example.com
SERVER_PORT=443
LOCATION_NAME=Finland

# Optional: enables "online now" and not-yet-flushed traffic in the bot.
# Must match TRAFFIC_STATS_SECRET from .env.hysteria.
HYSTERIA_STATS_URL=http://127.0.0.1:9999
HYSTERIA_STATS_SECRET=

# Certificate expiry shown on the "Server" screen
ACME_DIR=/var/lib/hysteria/acme
CERT_STATUS_PATH=/var/lib/hyvpn/cert.json
