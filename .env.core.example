# hy-core, CLI and certwatch -> /etc/hyvpn/.env.core

DATABASE_PATH=/var/lib/hyvpn/hyvpn.sqlite3
CORE_HOST=127.0.0.1
CORE_PORT=8080

# Must match TRAFFIC_STATS_SECRET in .env.hysteria
HYSTERIA_STATS_URL=http://127.0.0.1:9999
HYSTERIA_STATS_SECRET=replace_with_same_secret_as_hysteria

POLL_INTERVAL_SECONDS=60
FLUSH_INTERVAL_SECONDS=600

SERVER_DOMAIN=vpn.example.com
SERVER_PORT=443

# Profile name shown by VPN clients. Defaults to the domain.
LOCATION_NAME=Finland

# Where Hysteria2 keeps its ACME state, and where the certificate snapshot
# written by bin/cert_probe.py (hy-certwatch.timer) is stored.
ACME_DIR=/var/lib/hysteria/acme
CERT_STATUS_PATH=/var/lib/hyvpn/cert.json
